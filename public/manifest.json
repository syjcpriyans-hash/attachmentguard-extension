{
  "manifest_version": 3,
  "name": "AttachmentGuard",
  "short_name": "AttachGuard",
  "version": "0.5.0",
  "description": "View PDFs normally in Chrome, edit existing PDF text inline reliably, rename the output file, verify with PDFium, and save.",
  "minimum_chrome_version": "151",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle inline PDF editing"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  }
}