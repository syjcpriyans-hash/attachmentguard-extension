{
  "manifest_version": 3,
  "name": "AttachmentGuard",
  "short_name": "AttachGuard",
  "version": "0.3.0",
  "description": "Open and edit PDF documents directly in Chrome using packaged PDFium with strict font/style verification.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AttachmentGuard"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "minimum_chrome_version": "151",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "editor.html",
      "can_embed": true
    }
  }
}